# ===========================================
# Environment Variables for HireMe Application
# ===========================================
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-this

# ===========================================
# MySQL Database Configuration (Railway.app)
# ===========================================
# Get these values from Railway Dashboard -> MySQL -> Variables tab

# Option 1: Use individual variables
MYSQL_HOST=containers-us-west-xxx.railway.app
MYSQL_PORT=6547
MYSQL_USER=root
MYSQL_PASSWORD=your-railway-mysql-password
MYSQL_DATABASE=railway

# Option 2: Use full DATABASE_URL (recommended)
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://root:password@containers-us-west-xxx.railway.app:6547/railway

# ===========================================
# Email Configuration (Optional)
# ===========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
